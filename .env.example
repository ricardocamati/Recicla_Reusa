PYTHON_VERSION=3.11
MONGO_VERSION=7.0
MONGO_PORT=27018
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=Mongo
MONGO_DATABASE=recicla_reusa
MONGO_COLLECTION_USUARIOS=usuarios
MONGO_COLLECTION_ITENS=itens
MONGO_COLLECTION_PONTOS_COLETA=pontos_coleta
MONGO_COLLECTION_INTERESSES=interesses
MONGO_COLLECTION_NOTIFICACOES=notificacoes
# URI correspondente aos valores didáticos acima; ajuste se alterar a senha.
MONGO_URI=mongodb://root:***@localhost:27018/recicla_reusa?authSource=admin&replicaSet=rs0&directConnection=true
MONGO_EXPRESS_PORT=18081
MONGO_EXPRESS_USERNAME=cesumar
MONGO_EXPRESS_PASSWORD=cesumar
MONGO_DATA_VOLUME=recicla_reusa_mongo_data
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
SECURE_COOKIES=false
